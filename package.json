{
  "name": "rapid-superapp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "ulimit -n 4096 && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "cap:sync": "npm run build && npx cap sync android",
    "cap:sync:mobile": "vite build --mode mobile && npx cap sync android",
    "android:open": "npx cap open android",
    "android:apk": "npm run cap:sync && node scripts/gradle-build.js && node scripts/copy-apk.js",
    "android:apk:local": "npm run cap:sync:mobile && node scripts/gradle-build.js && node scripts/copy-apk.js"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/geolocation": "^8.2.0",
    "@googlemaps/js-api-loader": "^2.1.1",
    "axios": "^1.7.2",
    "laravel-echo": "^1.16.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.395.0",
    "pusher-js": "^8.4.0-rc2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^6.24.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "cypress": "^15.18.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.2",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.7",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "vite": "^5.3.1"
  }
}
