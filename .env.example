VITE_API_URL=https://api.fastrapid.com/api
# Set true when real admin email OTP is enabled; false accepts any 6-digit code
VITE_ADMIN_2FA_STRICT=false
VITE_PAYSTACK_KEY=
# Browser key — enable Maps JavaScript API + Directions API in Google Cloud Console
# Restrict by HTTP referrer (localhost + your production domain)
VITE_GOOGLE_MAPS_KEY=
